# ============================================================
# VdoU secret settings — TEMPLATE ONLY (no real keys here)
#
# How to use on your computer:
#   1. Copy this file and name the copy  .env.local
#   2. Paste your real values after the = signs in .env.local
#   (.env.local is private and is never uploaded to GitHub)
#
# On Vercel: add the same names and values in
#   Project → Settings → Environment Variables
# ============================================================

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → Publishable key (or "anon public" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ----- Payments (server only — never start these with NEXT_PUBLIC_) -----
# Razorpay → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Shown after running supabase/migrations/0006_plans_payments.sql
VDOU_SERVER_KEY=
